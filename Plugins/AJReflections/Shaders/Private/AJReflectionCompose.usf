// AJReflections Week 4A: opaque-stage material-hit diagnostics.
// Pixel-shader render-target load preserves existing pre-exposed SceneColor
// outside the diagnostic viewport; no scene color copy or post-process cache.
#include "/Engine/Private/Common.ush"

int2 ViewRectMin;
int DebugMode;
#if AJ_COMPOSE_HAS_INPUTS
Texture2D<float4> MaterialHitData0;
Texture2D<float4> MaterialHitData1;
Texture2D<uint> MaterialHitFlags;
Texture2D<float4> PrimaryTransport;
Texture2D<float4> ReflectionRadiance;
Texture2D<float4> SecondaryEmissive;
Texture2D<float4> SecondaryDirect;
#endif

float4 MainPS(float4 SvPosition : SV_POSITION) : SV_Target0
{
    float3 Color = 0.0f; // Backend-off modes 16..23 intentionally display black.
#if AJ_COMPOSE_HAS_INPUTS
    const uint2 LocalPixel = uint2(int2(SvPosition.xy) - ViewRectMin);
    if (DebugMode >= 16 && DebugMode <= 19)
    {
        // Preserve the exact Week 4A secondary-material diagnostics.
        const uint Flags = MaterialHitFlags.Load(int3(LocalPixel, 0));
        const bool bHit = (Flags & 2u) != 0u;
        const bool bValid = (Flags & 4u) != 0u;
        const float4 Data0 = MaterialHitData0.Load(int3(LocalPixel, 0));
        const float4 Data1 = MaterialHitData1.Load(int3(LocalPixel, 0));
        if (DebugMode == 16)
        {
            const uint Complexity = (Flags >> 3u) & 7u;
            if (bValid)
            {
                Color = float3(0.0f, 0.6f + 0.08f * float(min(Complexity, 4u)),
                    (Flags & 64u) != 0u ? 0.0f : 0.4f);
            }
            else if (bHit)
            {
                Color = float3(1.0f, 0.8f, 0.0f);
            }
        }
        else if (bValid)
        {
            if (DebugMode == 17) Color = Data0.xyz;
            if (DebugMode == 18) Color = Data0.www;
            if (DebugMode == 19) Color = Data1.xyz * 0.5f + 0.5f;
        }
    }
    else if (DebugMode == 20)
    {
        // Already PRE-EXPOSED HDR one-sample reflection contribution.
        Color = ReflectionRadiance.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 21)
    {
        // Secondary emissive *before* primary BRDF transport (pre-exposed).
        Color = SecondaryEmissive.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 22)
    {
        // Shadowed native directional hit-lighting (pre-exposed).
        Color = SecondaryDirect.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 23)
    {
        const float4 Transport = PrimaryTransport.Load(int3(LocalPixel, 0));
        const float3 W = max(Transport.xyz, 0.0f);
        // Monotonic display ONLY. The stored dimensionless HDR transport
        // remains untouched (and may have components above 1).
        Color = Transport.w > 0.0f ? W / (1.0f + W) : 0.0f;
    }
#endif
    return float4(Color, 1.0f);
}
