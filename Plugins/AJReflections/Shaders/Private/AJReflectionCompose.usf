// Opaque-stage reflection diagnostics and pre-exposed HDR presentation.
// Pixel-shader render-target load preserves existing pre-exposed SceneColor
// outside the diagnostic viewport; no scene color copy or post-process cache.
#include "/Engine/Private/Common.ush"

int2 ViewRectMin;
int DebugMode;
#if AJ_COMPOSE_HAS_INPUTS
Texture2D<float4> MaterialHitData0;
Texture2D<float4> MaterialHitData1;
Texture2D<uint> MaterialHitFlags;
Texture2D<float4> PrimaryTransport;
Texture2D<float4> ReflectionRadiance;
Texture2D<float4> SecondaryEmissive;
Texture2D<float4> SecondaryDirect;
Texture2D<float4> SecondaryEnvironment;
Texture2D<float4> SecondarySkyLighting;
Texture2D<uint> ReflectionRadianceFlags;
#endif
#if AJ_COMPOSE_HAS_HISTORY
Texture2D<float4> PreviousReflectionRadiance;
Texture2D<uint> PreviousReflectionRadianceFlags;
#endif
#if AJ_COMPOSE_HAS_REPROJECTION
Texture2D<float4> ReprojectedRadiance;
Texture2D<float> HistoryAcceptance;
Texture2D<uint> HistoryRejectionFlags;
Texture2D<float4> HistoryConsistency;
#endif
#if AJ_COMPOSE_HAS_ACCUMULATION
Texture2D<float4> AccumulatedRadiance;
Texture2D<uint> AccumulatedHistoryLength;
Texture2D<float> TemporalCurrentWeight;
#endif
int PresentationMode;
float TemporalMaxHistoryFrames;
float HistoryExposureRatio;
float DebugTraceDistanceMax;
uint HistoryResetReason;
float TemporalDepthThreshold;
float TemporalRoughnessThreshold;
float TemporalF0Threshold;


float4 MainPS(float4 SvPosition : SV_POSITION) : SV_Target0
{
    float3 Color = 0.0f;
    const uint2 LocalPixel = uint2(int2(SvPosition.xy) - ViewRectMin);
    if (DebugMode == -1)
    {
        // Hardware RGB-only blend adds this pre-exposed contribution to the
        // existing opaque-stage SceneColor. No BRDF or exposure scaling here.
#if AJ_COMPOSE_HAS_INPUTS
        if (PresentationMode == 1)
        {
            Color = ReflectionRadiance.Load(int3(LocalPixel, 0)).rgb;
        }
#endif
#if AJ_COMPOSE_HAS_ACCUMULATION
        if (PresentationMode == 2)
        {
            Color = AccumulatedRadiance.Load(int3(LocalPixel, 0)).rgb;
        }
#endif
        return float4(Color, 0.0f); // RGB-only blend keeps destination alpha.
    }
#if AJ_COMPOSE_HAS_INPUTS
    if (DebugMode >= 16 && DebugMode <= 19)
    {
        // Preserve existing secondary-material diagnostics.
        const uint Flags = MaterialHitFlags.Load(int3(LocalPixel, 0));
        const bool bHit = (Flags & 2u) != 0u;
        const bool bValid = (Flags & 4u) != 0u;
        const float4 Data0 = MaterialHitData0.Load(int3(LocalPixel, 0));
        const float4 Data1 = MaterialHitData1.Load(int3(LocalPixel, 0));
        if (DebugMode == 16)
        {
            const uint Complexity = (Flags >> 3u) & 7u;
            if (bValid)
            {
                Color = float3(0.0f, 0.6f + 0.08f * float(min(Complexity, 4u)),
                    (Flags & 64u) != 0u ? 0.0f : 0.4f);
            }
            else if (bHit)
            {
                Color = float3(1.0f, 0.8f, 0.0f);
            }
        }
        else if (bValid)
        {
            if (DebugMode == 17) Color = Data0.xyz;
            if (DebugMode == 18) Color = Data0.www;
            if (DebugMode == 19) Color = Data1.xyz * 0.5f + 0.5f;
        }
    }
    else if (DebugMode == 20)
    {
        // Already PRE-EXPOSED HDR one-sample reflection contribution.
        Color = ReflectionRadiance.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 21)
    {
        // Secondary emissive *before* primary BRDF transport (pre-exposed).
        Color = SecondaryEmissive.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 22)
    {
        // Shadowed native directional hit-lighting (pre-exposed).
        Color = SecondaryDirect.Load(int3(LocalPixel, 0)).xyz;
    }
    else if (DebugMode == 23)
    {
        const float4 Transport = PrimaryTransport.Load(int3(LocalPixel, 0));
        const float3 W = max(Transport.xyz, 0.0f);
        // Monotonic display ONLY. The stored dimensionless HDR transport
        // remains untouched (and may have components above 1).
        Color = Transport.w > 0.0f ? W / (1.0f + W) : 0.0f;
    }
#endif
#if AJ_COMPOSE_HAS_HISTORY
    if (DebugMode == 24)
    {
        // SAME PIXEL, no reprojection or blending. Conversion is display-only.
        Color = PreviousReflectionRadiance.Load(int3(LocalPixel, 0)).rgb
            * HistoryExposureRatio;
    }
    else if (DebugMode == 25)
    {
        const float RawHitDistance = PreviousReflectionRadiance.Load(int3(LocalPixel, 0)).a;
        const float DistanceDisplay = saturate(RawHitDistance / max(DebugTraceDistanceMax, 1.0e-6f));
        Color = float3(DistanceDisplay, DistanceDisplay, DistanceDisplay);
    }
    else if (DebugMode == 26)
    {
        const uint Flags = PreviousReflectionRadianceFlags.Load(int3(LocalPixel, 0));
        // Radiance flags: 7 complex primary, 6 partial secondary,
        // 5 direct, 4 emissive, 2 hit, 1 primary-supported, 0 primary valid.
        if      ((Flags & (1u << 7u)) != 0u) Color = float3(1.0f, 0.0f, 0.0f);
        else if ((Flags & (1u << 6u)) != 0u) Color = float3(1.0f, 0.0f, 1.0f);
        else if ((Flags & (1u << 5u)) != 0u) Color = float3(0.0f, 1.0f, 1.0f);
        else if ((Flags & (1u << 4u)) != 0u) Color = float3(1.0f, 0.55f, 0.0f);
        else if ((Flags & (1u << 2u)) != 0u) Color = float3(1.0f, 1.0f, 1.0f);
        else if ((Flags & (1u << 1u)) != 0u) Color = float3(0.0f, 0.3f, 0.8f);
        else if ((Flags & 1u) != 0u)         Color = float3(0.0f, 0.15f, 0.35f);
    }
#endif
    if (DebugMode == 27)
    {
        // Matches EAJReflectionHistoryResetReason (CPU diagnostic enum).
        // Green valid, black first frame, red camera cut, yellow resize,
        // orange gap, blue stateless, magenta backend off.
        if (HistoryResetReason == 0u)
            Color = float3(0.0f, 1.0f, 0.0f);
        else if (HistoryResetReason == 1u)
            Color = float3(0.0f, 0.0f, 1.0f);
        else if (HistoryResetReason == 2u)
            Color = 0.0f;
        else if (HistoryResetReason == 3u)
            Color = float3(1.0f, 0.0f, 0.0f);
        else if (HistoryResetReason == 4u)
            Color = float3(1.0f, 1.0f, 0.0f);
        else if (HistoryResetReason == 5u)
            Color = float3(1.0f, 0.5f, 0.0f);
        else if (HistoryResetReason == 6u)
            Color = float3(1.0f, 0.0f, 1.0f);
        else if (HistoryResetReason == 7u)
            Color = float3(0.55f, 0.0f, 0.75f);
        else if (HistoryResetReason == 8u)
            Color = float3(0.3f, 0.3f, 0.3f);
    }
#if AJ_COMPOSE_HAS_REPROJECTION
    if (DebugMode >= 28 && DebugMode <= 34)
    {
        const float4 Reprojected = ReprojectedRadiance.Load(int3(LocalPixel, 0));
        const uint Reasons = HistoryRejectionFlags.Load(int3(LocalPixel, 0));
        const float Accepted = HistoryAcceptance.Load(int3(LocalPixel, 0));
        const float4 Consistency = HistoryConsistency.Load(int3(LocalPixel, 0));
        if (DebugMode == 28)
        {
            Color = Reprojected.rgb; // Already in CURRENT frame pre-exposure space.
        }
        else if (DebugMode == 29)
        {
            Color = float3(Accepted, Accepted, Accepted); // White = accepted; black = rejected.
        }
        else if (DebugMode == 30)
        {
            // Priority is semantic; RGB values are display-only labels.
            if      ((Reasons & (1u << 0u)) != 0u) Color = float3(0, 1, 0);
            else if ((Reasons & (1u << 1u)) != 0u) Color = float3(0, 0, 0.35);
            else if ((Reasons & (1u << 2u)) != 0u) Color = float3(0, 0.2, 1);
            else if ((Reasons & (1u << 3u)) != 0u) Color = float3(0, 1, 1);
            else if ((Reasons & (1u << 4u)) != 0u) Color = float3(0.55, 0.55, 0.55);
            else if ((Reasons & (1u << 5u)) != 0u) Color = float3(1, 0, 0);
            else if ((Reasons & (1u << 6u)) != 0u) Color = float3(1, 1, 0);
            else if ((Reasons & (1u << 7u)) != 0u) Color = float3(1, 0.45, 0);
            else if ((Reasons & (1u << 8u)) != 0u) Color = float3(1, 0, 1);
            else if ((Reasons & (1u << 9u)) != 0u) Color = 1.0f;
        }
        else if (DebugMode == 31)
        {
            const float V = saturate(Consistency.x / max(TemporalDepthThreshold, 1.0e-6f));
            Color = float3(V, V, V); // Relative depth error / threshold.
        }
        else if (DebugMode == 32)
        {
            const float V = saturate(Consistency.y * 0.5f + 0.5f);
            Color = float3(V, V, V); // World-normal dot mapped [-1,1] to [0,1].
        }
        else if (DebugMode == 33)
        {
            Color = float3(
                saturate(Consistency.z / max(TemporalRoughnessThreshold, 1.0e-6f)),
                saturate(Consistency.w / max(TemporalF0Threshold, 1.0e-6f)),
                0.0f);
        }
        else if (DebugMode == 34)
        {
            const float V = saturate(Reprojected.a / max(DebugTraceDistanceMax, 1.0e-6f));
            Color = float3(V, V, V);
        }
    }
#endif
#if AJ_COMPOSE_HAS_ACCUMULATION
    if (DebugMode == 35)
    {
        Color = AccumulatedRadiance.Load(int3(LocalPixel, 0)).rgb;
    }
    else if (DebugMode == 36)
    {
        const uint Length = AccumulatedHistoryLength.Load(int3(LocalPixel, 0));
        const float V = saturate(float(Length) / max(TemporalMaxHistoryFrames, 1.0f));
        Color = float3(V, V, V); // Display only; stored count remains integer.
    }
    else if (DebugMode == 37)
    {
        const float V = saturate(TemporalCurrentWeight.Load(int3(LocalPixel, 0)));
        Color = float3(V, V, V);
    }
#endif
#if AJ_COMPOSE_HAS_INPUTS
    if (DebugMode == 38)
    {
        // The pre-exposed incident Skylight sample before primary transport.
        Color = SecondaryEnvironment.Load(int3(LocalPixel, 0)).rgb;
    }
    else if (DebugMode == 39)
    {
        // Geometry-hit environment radiance before primary transport.
        Color = SecondarySkyLighting.Load(int3(LocalPixel, 0)).rgb;
    }
    else if (DebugMode == 40)
    {
        const uint Flags = ReflectionRadianceFlags.Load(int3(LocalPixel, 0));
        // Green: evaluated (including valid black). Magenta: unsupported.
        // Red: invalid. Black: unavailable, disabled, or geometry miss.
        if ((Flags & (1u << 9u)) != 0u)
            Color = float3(0.0f, 1.0f, 0.0f);
        else if ((Flags & (1u << 11u)) != 0u)
            Color = float3(1.0f, 0.0f, 0.0f);
        else if ((Flags & (1u << 10u)) != 0u)
            Color = float3(1.0f, 0.0f, 1.0f);
    }
#endif
    return float4(Color, 1.0f);
}