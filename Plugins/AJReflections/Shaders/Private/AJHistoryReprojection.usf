// Reproject raw history using nearest-compatible raster correspondence.
// Transport accumulated history using independently validated,
// jitter-neutral nominal pixel correspondence.
// No radiance interpolation or spatial filtering.
#include "/Engine/Private/Common.ush"

#define AJ_HIST_ACCEPTED              (1u << 0u)
#define AJ_HIST_CURRENT_INVALID       (1u << 1u)
#define AJ_HIST_MOTION_INVALID        (1u << 2u)
#define AJ_HIST_OUTSIDE               (1u << 3u)
#define AJ_HIST_PREVIOUS_INVALID      (1u << 4u)
#define AJ_HIST_DEPTH                 (1u << 5u)
#define AJ_HIST_NORMAL                (1u << 6u)
#define AJ_HIST_ROUGHNESS             (1u << 7u)
#define AJ_HIST_F0                    (1u << 8u)
#define AJ_HIST_NO_CANDIDATE          (1u << 9u)

int2 OutputSize;
float HistoryExposureRatio;
float DepthThreshold;
float NormalThreshold;
float RoughnessThreshold;
float F0Threshold;
Texture2D<uint> CurrentRadianceFlags;
Texture2D<float4> CurrentSurface0;
Texture2D<float4> CurrentSurface1;
Texture2D<float4> MotionData;
Texture2D<float4> PreviousRadiance;
Texture2D<uint> PreviousRadianceFlags;
Texture2D<float4> PreviousSurface0;
Texture2D<float4> PreviousSurface1;
Texture2D<float4> PreviousAccumulatedRadiance;
Texture2D<uint> PreviousAccumulatedHistoryLength;
RWTexture2D<float4> ReprojectedRadiance;
RWTexture2D<float4> ReprojectedAccumulatedRadiance;
RWTexture2D<uint> ReprojectedAccumulatedHistoryLength;
RWTexture2D<uint> ReprojectedHistoryFlags;
RWTexture2D<float> HistoryAcceptance;
RWTexture2D<uint> HistoryRejectionFlags;
RWTexture2D<float4> HistoryConsistency;

// Bit 0 marks a valid primary sample, bit 1 a supported estimator;
// bit 7 marks a complex-primary fallback that must not reuse radiance.
bool AJSupportedPrimary(uint Flags)
{
    return (Flags & 3u) == 3u && (Flags & (1u << 7u)) == 0u;
}

bool AJValidSurface(float4 S0, float4 S1)
{
    return all(IsFinite(S0)) && all(IsFinite(S1))
        && S0.w > 0.0f && dot(S0.xyz, S0.xyz) > 0.25f;
}

// Debug RGBA: R relative depth error, G world-normal dot, B roughness
// difference, A max RGB F0-component difference. Not an accumulated signal.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint2 CurrentPixel = DispatchThreadId.xy;
    if (any(CurrentPixel >= uint2(OutputSize)))
    {
        return;
    }

    ReprojectedRadiance[CurrentPixel] = 0.0f;
    ReprojectedAccumulatedRadiance[CurrentPixel] = 0.0f;
    ReprojectedAccumulatedHistoryLength[CurrentPixel] = 0u;
    ReprojectedHistoryFlags[CurrentPixel] = 0u;
    HistoryAcceptance[CurrentPixel] = 0.0f;
    HistoryRejectionFlags[CurrentPixel] = 0u;
    HistoryConsistency[CurrentPixel] = 0.0f;

    const uint CurrentFlags = CurrentRadianceFlags.Load(int3(CurrentPixel, 0));
    const float4 CurrentS0 = CurrentSurface0.Load(int3(CurrentPixel, 0));
    const float4 CurrentS1 = CurrentSurface1.Load(int3(CurrentPixel, 0));
    if (!AJSupportedPrimary(CurrentFlags) || !AJValidSurface(CurrentS0, CurrentS1))
    {
        HistoryRejectionFlags[CurrentPixel] = AJ_HIST_CURRENT_INVALID;
        return;
    }

    const float4 Motion = MotionData.Load(int3(CurrentPixel, 0));
    const float2 PrevCenter = Motion.xy;
    const float ExpectedPrevViewZ = Motion.z;
    if (!all(IsFinite(Motion)) || Motion.w < 0.5f
        || ExpectedPrevViewZ <= 0.0f)
    {
        HistoryRejectionFlags[CurrentPixel] = AJ_HIST_MOTION_INVALID;
        return;
    }

    // Previous coordinates are in view-local pixel-center units, not buffer UV.
    // Never clamp to a border texel; outside previous-view support is invalid.
    if (any(PrevCenter < 0.0f) || any(PrevCenter >= float2(OutputSize)))
    {
        HistoryRejectionFlags[CurrentPixel] = AJ_HIST_OUTSIDE | AJ_HIST_NO_CANDIDATE;
        return;
    }

    const int2 Base = int2(floor(PrevCenter - 0.5f));
    uint RejectedReasons = 0u;
    bool bFoundAccepted = false;
    bool bFoundDiagnostic = false;
    float BestAcceptedDistanceSq = 3.402823e+38f;
    float BestAcceptedDepthError = 3.402823e+38f;
    float BestDiagnosticError = 3.402823e+38f;
    float4 BestAcceptedRadiance = 0.0f;
    int2 BestAcceptedPixel = int2(0, 0);
    uint BestAcceptedFlags = 0u;
    float4 BestAcceptedDiagnostic = 0.0f;
    float4 BestDiagnostic = 0.0f;

    // Search the previous raw 2x2 footprint. Rank compatible texel
    // centres by squared pixel distance, then by depth and row-major order.
    // Raw radiance, flags and diagnostics use the same winning texel.
    [unroll]
    for (int Y = 0; Y < 2; ++Y)
    {
        [unroll]
        for (int X = 0; X < 2; ++X)
        {
            const int2 Candidate = Base + int2(X, Y);
            if (any(Candidate < int2(0, 0)) || any(Candidate >= OutputSize))
            {
                RejectedReasons |= AJ_HIST_OUTSIDE;
                continue;
            }

            const float2 CandidateCenter = float2(Candidate) + 0.5f;
            const float2 Delta = CandidateCenter - PrevCenter;
            // A sample exactly one pixel away on either axis has zero
            // separable footprint support. Strict inequality preserves
            // genuine arbitrarily small nonzero subpixel overlap.
            if (any(abs(Delta) >= 1.0f))
            {
                continue;
            }
            const float DistanceSq = dot(Delta, Delta);

            const uint PreviousFlags = PreviousRadianceFlags.Load(int3(Candidate, 0));
            const float4 PreviousS0 = PreviousSurface0.Load(int3(Candidate, 0));
            const float4 PreviousS1 = PreviousSurface1.Load(int3(Candidate, 0));
            if (!AJSupportedPrimary(PreviousFlags) || !AJValidSurface(PreviousS0, PreviousS1))
            {
                RejectedReasons |= AJ_HIST_PREVIOUS_INVALID;
                continue;
            }

            // Relative linear-depth consistency (100 UE-unit floor = 1 m in
            // the default cm world scale). Expected depth comes from previous
            // clip depth, including native z-velocity for moving primitives.
            const float DepthError = abs(PreviousS0.w - ExpectedPrevViewZ)
                / max(abs(ExpectedPrevViewZ), 100.0f);
            const float NormalDot = dot(normalize(CurrentS0.xyz), normalize(PreviousS0.xyz));
            const float RoughnessError = abs(CurrentS1.w - PreviousS1.w);
            const float3 F0Difference = abs(CurrentS1.xyz - PreviousS1.xyz);
            const float F0Error = max(F0Difference.x, max(F0Difference.y, F0Difference.z));
            if (!IsFinite(DepthError) || !IsFinite(NormalDot)
                || !IsFinite(RoughnessError) || !IsFinite(F0Error))
            {
                RejectedReasons |= AJ_HIST_PREVIOUS_INVALID;
                continue;
            }

            const float4 Diagnostic = float4(DepthError, NormalDot, RoughnessError, F0Error);
            if (!bFoundDiagnostic || DepthError < BestDiagnosticError)
            {
                bFoundDiagnostic = true;
                BestDiagnosticError = DepthError;
                BestDiagnostic = Diagnostic;
            }

            uint CandidateReasons = 0u;
            if (DepthError > DepthThreshold) CandidateReasons |= AJ_HIST_DEPTH;
            if (NormalDot < NormalThreshold) CandidateReasons |= AJ_HIST_NORMAL;
            if (RoughnessError > RoughnessThreshold) CandidateReasons |= AJ_HIST_ROUGHNESS;
            if (F0Error > F0Threshold) CandidateReasons |= AJ_HIST_F0;
            if (CandidateReasons != 0u)
            {
                RejectedReasons |= CandidateReasons;
                continue;
            }

            const float4 Radiance = PreviousRadiance.Load(int3(Candidate, 0));
            if (!all(IsFinite(Radiance)))
            {
                RejectedReasons |= AJ_HIST_PREVIOUS_INVALID;
                continue;
            }
            
            // Compatibility has already passed. Depth is a tie-breaker, not
            // a substitute for correspondence with the predicted pixel centre.
            // Exact float ties use a fixed row-major coordinate order; no
            // epsilon can allow a meaningfully farther candidate to win.
            const bool bCloser = DistanceSq < BestAcceptedDistanceSq;
            const bool bEqualDistance = DistanceSq == BestAcceptedDistanceSq;
            const bool bBetterDepth = DepthError < BestAcceptedDepthError;
            const bool bEqualDepth = DepthError == BestAcceptedDepthError;
            const bool bEarlierRowMajor = Candidate.y < BestAcceptedPixel.y
                || (Candidate.y == BestAcceptedPixel.y && Candidate.x < BestAcceptedPixel.x);
            if (!bFoundAccepted || bCloser
                || (bEqualDistance && (bBetterDepth || (bEqualDepth && bEarlierRowMajor))))
            {
                bFoundAccepted = true;
                BestAcceptedDistanceSq = DistanceSq;
                BestAcceptedDepthError = DepthError;
                BestAcceptedRadiance = Radiance;
                BestAcceptedPixel = Candidate;
                BestAcceptedFlags = PreviousFlags;
                BestAcceptedDiagnostic = Diagnostic;
            }
        }
    }

    HistoryConsistency[CurrentPixel] = bFoundAccepted
        ? BestAcceptedDiagnostic
        : (bFoundDiagnostic ? BestDiagnostic : 0.0f);
    if (bFoundAccepted)
    {
        ReprojectedRadiance[CurrentPixel] = float4(
            BestAcceptedRadiance.rgb * HistoryExposureRatio,
            BestAcceptedRadiance.a); // Previous material hit T: unmodified world units.
        // Raw history uses the nearest compatible raster texel.
        // Accumulated history uses independently validated,
        // jitter-neutral nominal pixel correspondence.

        // Remove raster jitter displacement from accumulated-history transport.
        // Real camera and primitive motion remain in Motion.xy.
        const float2 JitterDeltaPixels =
            (View.TemporalAAJitter.zw - View.TemporalAAJitter.xy)
            * float2(
                 0.5f * float(OutputSize.x),
                -0.5f * float(OutputSize.y));

        const float2 AccumPrevCenter = PrevCenter - JitterDeltaPixels;

        // Accumulated history represents samples assigned to a nominal pixel
        // footprint rather than an exact jittered raster sample.
        if (all(IsFinite(AccumPrevCenter))
            && all(AccumPrevCenter >= 0.0f)
            && all(AccumPrevCenter < float2(OutputSize)))
        {
            const int2 AccumPixel = int2(floor(AccumPrevCenter));

            const uint AccumFlags =
                PreviousRadianceFlags.Load(int3(AccumPixel, 0));

            const float4 AccumS0 =
                PreviousSurface0.Load(int3(AccumPixel, 0));

            const float4 AccumS1 =
                PreviousSurface1.Load(int3(AccumPixel, 0));

            if (AJSupportedPrimary(AccumFlags)
                && AJValidSurface(AccumS0, AccumS1))
            {
                const float DepthError =
                    abs(AccumS0.w - ExpectedPrevViewZ)
                    / max(abs(ExpectedPrevViewZ), 100.0f);

                const float NormalDot =
                    dot(normalize(CurrentS0.xyz), normalize(AccumS0.xyz));

                const float RoughnessError =
                    abs(CurrentS1.w - AccumS1.w);

                const float3 F0Difference =
                    abs(CurrentS1.xyz - AccumS1.xyz);

                const float F0Error =
                    max(F0Difference.x,
                        max(F0Difference.y, F0Difference.z));

                if (IsFinite(DepthError)
                    && IsFinite(NormalDot)
                    && IsFinite(RoughnessError)
                    && IsFinite(F0Error)
                    && DepthError <= DepthThreshold
                    && NormalDot >= NormalThreshold
                    && RoughnessError <= RoughnessThreshold
                    && F0Error <= F0Threshold)
                {
                    const float4 PriorAccumulated =
                        PreviousAccumulatedRadiance.Load(
                            int3(AccumPixel, 0));

                    const uint PriorLength =
                        PreviousAccumulatedHistoryLength.Load(
                            int3(AccumPixel, 0));

                    if (PriorLength > 0u
                        && all(IsFinite(PriorAccumulated)))
                    {
                        ReprojectedAccumulatedRadiance[CurrentPixel] =
                            float4(
                                PriorAccumulated.rgb * HistoryExposureRatio,
                                0.0f);

                        ReprojectedAccumulatedHistoryLength[CurrentPixel] =
                            PriorLength;
                    }
                }
            }
        }

        ReprojectedHistoryFlags[CurrentPixel] = BestAcceptedFlags;
        HistoryAcceptance[CurrentPixel] = 1.0f;
        HistoryRejectionFlags[CurrentPixel] = AJ_HIST_ACCEPTED;
    }
    else
    {
        HistoryRejectionFlags[CurrentPixel] = RejectedReasons | AJ_HIST_NO_CANDIDATE;
    }
}
